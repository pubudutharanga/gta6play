# Production origin, without a trailing slash. Used for canonical, OG, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://gta6play.vercel.app

# Optional. When set, the iframe adapter loads this URL instead of the placeholder.
# Leave empty to use the placeholder adapter.
NEXT_PUBLIC_GAME_URL=

# Set to false to block known AI training crawlers in robots.txt.
# Search and user-initiated AI fetchers are always allowed.
ALLOW_AI_TRAINING_BOTS=true

# Search-console verification. Leave empty to omit the meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
